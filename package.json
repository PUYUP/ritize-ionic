{
  "name": "ritize",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:sql:wasm && vite",
    "build": "tsc && vite build",
    "copy:sql:wasm": "copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm public/assets",
    "build:web": "npm run copy:sql:wasm && npm run build",
    "typeorm:migration:run": "npx typeorm-ts-node-esm migration:run -d src/databases/datasources/NotesDataSource.migration.ts",
    "typeorm:migration:generate": "npx typeorm-ts-node-esm migration:generate -d src/databases/datasources/NotesDataSource.migration.ts",
    "typeorm:migration:generate:initialNotes": "npx typeorm-ts-node-esm migration:generate src/databases/migrations/notes/InitialNotes -d src/databases/datasources/NotesDataSource.migration.ts",
    "postinstall": "node ./scripts/modify-typeorm.cjs",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@capacitor/toast": "^8.0.1",
    "@capgo/capacitor-speech-recognition": "^8.1.11",
    "@excalidraw/excalidraw": "^0.18.0-abeeaeb",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "@ljharb/tsconfig": "^0.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "date-fns": "^4.4.0",
    "ionicons": "^8.1.0",
    "iso-language-codes": "^2.0.1",
    "postcss": "^8.5.26",
    "quill": "^2.0.3",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.86.0",
    "react-number-format": "^5.4.5",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swiper": "^14.1.0",
    "tailwindcss": "^4.3.3",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^26.3.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "copyfiles": "^2.4.1",
    "cypress": "^13.5.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "terser": "^5.16.0",
    "ts-node": "^10.9.2",
    "tsex": "^4.0.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "unplugin-swc": "^1.5.11",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "sql.js": "1.11.0"
  },
  "description": "An Ionic project"
}
